# ==============================================================================
# Beauty Ops Copilot — Environment Configuration Example
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: Google Cloud Vertex AI (Default Enterprise Sovereign Mode)
# Requires: gcloud auth application-default login
# ------------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=eu
MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# OPTION B: Google AI Studio (Standalone API Key Mode)
# If you don't have a GCP project, comment Option A and uncomment this:
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy...
# MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Retail Mock API & Backend Configuration
# ------------------------------------------------------------------------------
RETAIL_API_URL=http://127.0.0.1:8090
BACKEND_DATA_DIR=.data
SESSIONS=sqlite

# ------------------------------------------------------------------------------
# Model Resilience & Performance Tuning
# ------------------------------------------------------------------------------
MODEL_TIMEOUT_S=25
MODEL_RETRY_ATTEMPTS=3
THINKING_LEVEL_ADVISOR=LOW
THINKING_LEVEL_ROUTER=LOW
THINKING_LEVEL_CATALOG=LOW
CONTEXT_CACHE=0

# ------------------------------------------------------------------------------
# Observability & Governance
# ------------------------------------------------------------------------------
TELEMETRY=off
GOVERNANCE=enforce
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

