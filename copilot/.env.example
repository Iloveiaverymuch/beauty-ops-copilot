GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=eu
MODEL=gemini-3.8-flash
WORKSPACE_MCP_URL=http://127.0.0.1:8080/mcp
WORKSPACE_MCP_TOKEN=dev-agent-token
WORKSPACE_PROMPT=hardened_v2
WORKSPACE_CONFIRM_WRITES=1
# Backwards compatibility fallbacks
M365_MCP_URL=http://127.0.0.1:8080/mcp
M365_MCP_TOKEN=dev-agent-token
M365_PROMPT=hardened_v2
M365_CONFIRM_WRITES=1
ROUTER_MODE=agenttool
GOVERNANCE=enforce
MODEL_TIMEOUT_S=60
MODEL_RETRY_ATTEMPTS=3
TELEMETRY=off
THINKING_LEVEL=
THINKING_LEVEL_ROUTER=LOW
THINKING_LEVEL_CATALOG=LOW
THINKING_LEVEL_WORKSPACE=
THINKING_LEVEL_M365=
CONTEXT_CACHE=0
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
